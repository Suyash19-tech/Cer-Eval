# Copy to .env. Never commit real secrets.
HAL_ENV=development
HAL_DATABASE_URL=sqlite:///../data/hal.db
# Compose uses: postgresql+psycopg://hal:CHANGE_ME@postgres:5432/hal
HAL_DATA_DIR=../data
HAL_MAX_UPLOAD_MB=50
HAL_MAX_ZIP_UNCOMPRESSED_MB=500
HAL_MAX_ZIP_ENTRIES=500
# Human-review access: comma separated "reviewer_id:token" pairs. Generate long random tokens.
HAL_REVIEWER_TOKENS=
# Local inference only. Offline mode forbids any network model download at runtime.
HAL_OFFLINE=true
